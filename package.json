{
  "name": "@toolbox/widgets",
  "version": "0.1.0",
  "description": "Shared widget core and portable bundle format for the Toolbox family of apps (desktop, NAS, MCP).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "imapflow": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
